# SafeSky backend — шаблон окружения. Реальные значения НЕ коммитить:
# на Render секреты прописываются в Environment Variables сервиса.

# --- БД ---
# Supabase PostgreSQL (потом перенос на РФ-VPS сменой строки подключения — Prisma).
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME?schema=public

# --- Авторизация ---
# Секрет подписи JWT. Сгенерировать: openssl rand -hex 32
JWT_SECRET=change-me

# --- CORS ---
# Точные origin через запятую. http://localhost:* разрешён автоматически.
CORS_ORIGINS=https://ziz6956.github.io

# --- Авторизация по номеру ---
# console  — dev-режим: код печатается в лог сервера, ничего не отправляется.
# exolve   — SMS через МТС Exolve (канон SAF-190: 3 ₽/SMS).
# plusofon — Flash Call (SAF-223): звонок с проговариванием кода, код = 4 цифры.
SMS_PROVIDER=console
# Для SMS_PROVIDER=exolve:
EXOLVE_API_KEY=
EXOLVE_SENDER=
# Для SMS_PROVIDER=plusofon — access_token Flash Call-аккаунта Plusofon
# (выдаётся при создании аккаунта POST /api/v1/flash-call). Основной ключ ЛК
# PLUSOFON_API_KEY для отправки вызова НЕ подходит (403) — он только для
# управления аккаунтами/пакетами по API, приложением не читается.
PLUSOFON_FLASH_CALL_TOKEN=
# Секрет колбэка Flash Call — генерирует FE: openssl rand -hex 16.
# В production при plusofon обязателен.
PLUSOFON_WEBHOOK_SECRET=
# База URL колбэка Flash Call. Пусто — берётся RENDER_EXTERNAL_URL (Render
# подставляет сам); локально можно задать явно, например http://localhost:3000.
FLASH_CALLBACK_BASE_URL=

# --- Прочее ---
# TELEGRAM_BOT_TOKEN=            # зарезервировано (дублирование кода в Telegram — опция, не реализовано)
NODE_ENV=production
PORT=3000
