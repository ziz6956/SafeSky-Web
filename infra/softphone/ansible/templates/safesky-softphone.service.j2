[Unit]
Description=SafeSky softphone worker (baresip ctrl_tcp, очередь Render)
After=network-online.target safesky-baresip.service
Wants=network-online.target
Requires=safesky-baresip.service
# SAF-270: воркер не рестартует бесконечно — не чаще StartLimitBurst раз за
# StartLimitIntervalSec, дальше юнит в failed, причина в
# `journalctl -u safesky-softphone`. Восстановление:
#   systemctl reset-failed safesky-softphone && systemctl start safesky-softphone
StartLimitIntervalSec=1800
StartLimitBurst=3

[Service]
Type=simple
User={{ service_user }}
EnvironmentFile=/etc/safesky-softphone/env
ExecStart=/usr/bin/python3 {{ deploy_dir }}/worker.py
Restart=on-failure
RestartSec=15
NoNewPrivileges=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
