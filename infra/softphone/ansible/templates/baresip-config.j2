# baresip config — управляется Ansible (SAF-276). Правки вручную переживут
# только до следующего прогона плейбука.
#
# Аудиоисточник НЕ задан (фикс A1): WAV подключается воркером по ctrl_tcp
# командой `ausrc aufile,…` только по событию CALL_ESTABLISHED (200 OK).
# Если без источника звонок не держится в фазе 183 — прогон плейбука с
# AUDIO_FALLBACK_SILENCE=true: в конфиг попадёт silence.wav (10 мин) как
# источник, воркер так же подменит его на тестовый WAV по 200 OK (фикс A2).

{% if baresip_version is version('3', '>=') %}
module_app		ctrl_tcp.so
module_aufile		aufile.so
module_auconv		auconv.so
module_auresamp		auresamp.so
module_g711		g711.so
{% else %}
module_path		/usr/lib/x86_64-linux-gnu/baresip/modules
module			aufile.so
module			auconv.so
module			auresamp.so
module			g711.so
module			ctrl_tcp.so
{% endif %}

# SIP-сигнализация Plusofon (UDP 5060; ufw открывает входящие только от SIP-сети
# Plusofon — SAF-270). RTP — стандартные 10000–20000/udp.
sip_listen		0.0.0.0:5060

# Управляющий TCP-сокет для воркера (только loopback — SAF-251).
ctrl_tcp_listen		127.0.0.1:4444

{% if audio_fallback_silence | bool %}
# Фикс A2: источник-заглушка, чтобы звонок держался в фазе 183 до ответа.
# По CALL_ESTABLISHED воркер подменяет источник на тестовый WAV.
audio_source		aufile,{{ deploy_dir }}/audio/silence.wav
{% endif %}
