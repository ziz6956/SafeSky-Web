# /etc/safesky-softphone/env — генерируется Ansible из шаблона.
# Секреты в репозитории не хранятся; файл на сервере доступен только root (0600).
# Обновляется плейбуком только при полном комплекте SIP-секретов в окружении
# (SAF-251): прогон без секретов этот файл не трогает.

# SIP-аккаунт Plusofon (создаётся bootstrap_sip.py или в ЛК Plusofon).
# ВАЖНО: SIP_SERVER — персональный адрес из ЛК Plusofon вида
# <аккаунт>.voice.plusofon.ru; «sip.plusofon.ru» не существует (SAF-235).
SIP_SERVER={{ sip_server | default('', true) }}
SIP_PORT=5060
SIP_LOCAL_PORT=5060
SIP_LOGIN={{ sip_login }}
SIP_PASSWORD={{ sip_password }}

# Аудио для воспроизведения
AUDIO_FILE={{ deploy_dir }}/audio/test-call-ru.wav

{% if queue_enabled | default(false) | bool %}
# Очередь заданий (Render, HTTP-эндпоинты /api/test-call/queue/*).
# ВКЛЮЧЕНО осознанно (QUEUE_ENABLED=true) и только на РФ-хосте: опрос очереди
# на не-РФ хосте запрещён ч. 5 ст. 18 152-ФЗ (SAF-240 §4, G-CALL-2, SAF-246).
QUEUE_BASE_URL={{ queue_base_url }}
WORKER_TOKEN={{ worker_token }}
{% else %}
# Очередь заданий ВЫКЛЮЧЕНА (по умолчанию): опрос очереди Render на не-РФ
# хосте запрещён ч. 5 ст. 18 152-ФЗ (SAF-240 §4, G-CALL-2, SAF-246).
# Включение — осознанное действие оператора (QUEUE_ENABLED=true), только на
# РФ-хосте, см. infra/softphone/ansible/playbook.yml.
# QUEUE_BASE_URL=
# WORKER_TOKEN=
{% endif %}
POLL_INTERVAL=2.0
REG_TIMEOUT=30.0
REG_RETRY_SEC=300
CALL_TIMEOUT=30
