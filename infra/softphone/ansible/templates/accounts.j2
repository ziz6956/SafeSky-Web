# SIP-аккаунт Plusofon — управляется Ansible (SAF-276), 0600, читается только
# пользователем safesky (процесс baresip). Формат baresip:
#   <sip:uri>;auth_pass=<пароль>;regint=<интервал перерегистрации, с>
{% if '@' in sip_login %}
<sip:{{ sip_login }}>;auth_pass={{ sip_password }};regint=120
{% else %}
<sip:{{ sip_login }}@{{ sip_server }}>;auth_pass={{ sip_password }};regint=120
{% endif %}
